# Скопируйте в .env и заполните. НЕ коммитьте .env.
# Входная роль stash_login — член групп stash_auth/stash_app (пулы переключают роль сами).
DATABASE_DSN=postgresql://stash_login:PASSWORD@localhost:5432/stash
# Мастер-ключ: шифрование API-ключей пользователей (Fernet) и подпись файловых ссылок (HMAC).
SECRET_KEY=replace-with-long-random-string
FILES_DIR=/home/saver/stash-files
# Публичный адрес API для файловых ссылок (за туннелем). Пусто = брать из запроса.
PUBLIC_BASE_URL=https://stashapp.ru
SESSION_DAYS=30
WORKER_CONCURRENCY=2
FILE_URL_TTL=86400
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3:latest
TRANSCRIBE_PYTHON=/home/saver/stash-transcribe/.venv/bin/python
TRANSCRIBE_SCRIPT=/home/saver/stash-transcribe/transcribe.py
CORS_ORIGINS=*
# Email владельца: доступ к /admin/* (список пользователей, удаление). Пусто = админки нет.
ADMIN_EMAIL=
# Каталог собранного фронтенда (pnpm --filter @inbox/web build → dist). Пусто = не раздавать.
FRONTEND_DIST=

# --- Транскрибация видео по ссылке (VK Видео, Rutube) ---
# Включать только после чек-листа ручной проверки (docs/video-transcription.md).
VIDEO_LINKS_ENABLED=false
VIDEO_PLATFORMS=vk,rutube
VIDEO_ALLOW_SUBTITLES=true
VIDEO_ALLOW_AUDIO_DOWNLOAD=true
VIDEO_TMP_DIR=/home/saver/stash-video-tmp
VIDEO_CONCURRENCY=1
VIDEO_WHISPER_THREADS=8
VIDEO_NICE=10
VIDEO_MIN_FREE_DISK_MB=2048
# 0 = без ограничений (решение владельца: лимитов по длительности нет)
VIDEO_MAX_DURATION_MIN=0
VIDEO_DAILY_MINUTES_PER_USER=0
# Бинарники (подменяются в тестах); yt-dlp обновлять скриптом scripts/update-ytdlp.sh
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# Ключ владельца для пользователей без своего ключа (аннотации за счёт сервиса). Пусто = пропуск.
DEFAULT_AI_API_KEY=
